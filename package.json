{
  "name": "number-scanner",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "TSX_TSCONFIG_PATH=tsconfig.test.json node --import tsx --test --test-force-exit tests/*.test.ts tests/*.test.tsx",
    "typecheck": "tsc --noEmit --incremental false",
    "format": "prettier --write \"app/**/*.{ts,tsx,css}\" \"lib/**/*.ts\" \"tests/**/*.{ts,tsx}\" package.json tsconfig.json tsconfig.test.json .prettierrc.json",
    "format:check": "prettier --check \"app/**/*.{ts,tsx,css}\" \"lib/**/*.ts\" \"tests/**/*.{ts,tsx}\" package.json tsconfig.json tsconfig.test.json .prettierrc.json",
    "check": "npm run format:check && npm run build && npm run typecheck && npm test"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.116.0",
    "next": "16.3.3",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "tesseract.js": "6.0.1"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.3",
    "@types/react-dom": "^19.0.2",
    "fake-indexeddb": "^6.2.5",
    "happy-dom": "^20.14.6",
    "prettier": "3.9.10",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "^5.7.2"
  }
}
